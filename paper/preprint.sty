% preprint.sty -- arXiv-style preprint layout
% Times text, US-letter page with a 6.5 x 9 in text block, a ruled title block,
% a running head with a short title and "A Preprint", and a keywords line.
% Written for this project; released under the MIT licence with the repository.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{preprint}[2026/11/07 arXiv-style preprint layout]

% ---------------------------------------------------------------- fonts
\RequirePackage[T1]{fontenc}
\RequirePackage{mathptmx}
\IfFileExists{tgtermes.sty}{\RequirePackage{tgtermes}}{}
\RequirePackage[scaled=0.9]{helvet}

% ---------------------------------------------------------------- page
\RequirePackage[letterpaper,textwidth=6.5in,textheight=9in,top=1in,
  headheight=12pt,headsep=25pt,footskip=30pt]{geometry}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt}

% ---------------------------------------------------------------- running head
\RequirePackage{fancyhdr}
\newcommand{\headeright}{A Preprint}
\newcommand{\undertitle}{A Preprint}
\newcommand{\shorttitle}{}
\fancyhf{}
\pagestyle{fancy}
\fancyhead[C]{\footnotesize\shorttitle}
\fancyhead[R]{\footnotesize\scshape\headeright}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}

% ---------------------------------------------------------------- headings
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-2.0ex \@plus -0.5ex \@minus -0.2ex}{1.2ex \@plus 0.3ex \@minus 0.2ex}%
  {\normalfont\large\bfseries\raggedright}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-1.8ex \@plus -0.5ex \@minus -0.2ex}{0.6ex \@plus 0.2ex}%
  {\normalfont\normalsize\bfseries\raggedright}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex \@plus -0.5ex \@minus -0.2ex}{0.5ex \@plus 0.2ex}%
  {\normalfont\normalsize\bfseries\raggedright}}
\renewcommand{\paragraph}{\@startsection{paragraph}{4}{\z@}%
  {1.2ex \@plus 0.5ex \@minus 0.2ex}{-1em}%
  {\normalfont\normalsize\bfseries}}

% ---------------------------------------------------------------- title block
\def\@toptitlebar{\hrule height 2pt\vskip 0.25in\vskip -\parskip}
\def\@bottomtitlebar{\vskip 0.29in\vskip -\parskip\hrule height 1pt\vskip 0.09in}

\renewcommand{\maketitle}{%
  \par
  \begingroup
    \renewcommand{\thefootnote}{\fnsymbol{footnote}}%
    \@maketitle
    \@thanks
  \endgroup
  \thispagestyle{plain}%
  \setcounter{footnote}{0}%
  \global\let\maketitle\relax
  \global\let\@maketitle\relax
  \gdef\@thanks{}\gdef\@author{}\gdef\@title{}%
  \global\let\thanks\relax}

\renewcommand{\@maketitle}{%
  \vbox{%
    \hsize\textwidth
    \linewidth\hsize
    \vskip 0.1in
    \@toptitlebar
    \centering
    {\LARGE\bfseries\@title\par}
    \@bottomtitlebar
    {\scshape\undertitle}\par
    \vskip 0.18in
    \def\And{\end{tabular}\hfil\linebreak[0]\hfil\begin{tabular}[t]{c}\bfseries\ignorespaces}%
    \def\AND{\end{tabular}\hfil\linebreak[4]\hfil\begin{tabular}[t]{c}\bfseries\ignorespaces}%
    \begin{tabular}[t]{c}\bfseries\ignorespaces\@author\end{tabular}%
    \par\vskip 0.22in
    {\normalsize\@date}\par
    \vskip 0.22in}}

% ---------------------------------------------------------------- abstract and keywords
\renewenvironment{abstract}%
  {\centerline{\large\scshape Abstract}\vspace{0.5ex}\begin{quote}}%
  {\par\end{quote}\vskip 1ex}

\newcommand{\keywordname}{{\bfseries\emph{Keywords}}}
\newcommand{\keywords}[1]{\par\addvspace\medskipamount
  {\rightskip=0pt plus1cm
   \def\and{\ifhmode\unskip\nobreak\fi\ $\cdot$\ }%
   \noindent\keywordname\enspace\ignorespaces#1\par}%
  \addvspace\medskipamount}

\endinput
